      "borderColor": "line", "separatorColor": "line",
      "focusColor": "accent", "focusedBorderColor": "accent"
    },
    "MainWindow.background": "bg",
    "MainToolbar.background": "bg", "MainToolbar.inactiveBackground": "bg",
    "StatusBar.background": "bg",
    "ToolWindow.background": "bg2", "ToolWindow.Header.background": "bg2", "ToolWindow.Header.inactiveBackground": "bg2",
    "ToolWindow.Stripe.background": "bg",
    "ToolWindow.Button.selectedBackground": "sel", "ToolWindow.Button.selectedForeground": "#ffffff",
    "EditorTabs.background": "bg", "EditorTabs.underlinedTabBackground": "bg3", "EditorTabs.underlineColor": "accent",
    "EditorTabs.inactiveUnderlineColor": "sel", "EditorTabs.hoverBackground": "bg3",
